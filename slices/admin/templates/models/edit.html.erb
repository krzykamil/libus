<form hx-patch="/admin/models/<%= model_name %>/<%= model_id %>" hx-target="this" hx-swap="outerHTML">
	<% attributes.each do |key, value| %>
		<label><%= key %></label>
		<input type="text" name="<%= key %>" value="<%= value %>">
		<br/>
	<% end %>
	<input type="hidden" name="_csrf_token" value="<%= csrf_token %>">

	<button class="btn">Submit</button>
	<button class="btn" hx-get="/admin/models/<%= model_name %>/<%= model_id %>/reload_show">Cancel</button>
</form>
